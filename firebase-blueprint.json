{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing authentication and profile details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["customer", "staff", "admin"] },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 255 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "role", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Travel booking made by customer for package, hotel, or vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "enum": ["package", "hotel", "vehicle"] },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemTitle": { "type": "string", "maxLength": 200 },
        "destinationName": { "type": "string", "maxLength": 120 },
        "startDate": { "type": "string", "maxLength": 30 },
        "endDate": { "type": "string", "maxLength": 30 },
        "guests": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "refunded", "failed"] },
        "specialRequests": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "customerName", "type", "itemId", "totalAmount", "status", "paymentStatus", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer inquiry or custom itinerary request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "destination": { "type": "string", "maxLength": 120 },
        "serviceType": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "assigned", "contacted", "converted", "closed"] },
        "assignedStaff": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "destination", "serviceType", "message", "status", "createdAt"]
    },
    "Destination": {
      "title": "Destination",
      "description": "Travel corridor and destination details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 255 },
        "description": { "type": "string", "maxLength": 3000 },
        "heroImage": { "type": "string", "maxLength": 1000 },
        "region": { "type": "string", "maxLength": 80 },
        "bestTimeToVisit": { "type": "string", "maxLength": 80 },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "slug", "name", "tagline", "heroImage", "region"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review and testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 120 },
        "authorLocation": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "journeyType": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorName", "rating", "comment", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User or staff alerts regarding bookings or travel updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and credentials"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Travel bookings"
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Customer enquiries and custom itinerary quotes"
    },
    "/destinations/{destinationId}": {
      "schema": { "$ref": "#/entities/Destination" },
      "description": "Curated travel destination records"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer reviews and testimonials"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    }
  }
}
